+// Review items from the #898 re-review (#899).
+
+test('#899-1: DROP DEFAULT and ADD GENERATED ALWAYS are refused', () => {
+  assert.deepEqual(why('ALTER TABLE t ALTER COLUMN c DROP DEFAULT;'), ['drops a column DEFAULT']);
+  assert.deepEqual(why('ALTER TABLE t ALTER c DROP DEFAULT;'), ['drops a column DEFAULT']);
+  assert.deepEqual(why('ALTER TABLE t ALTER COLUMN id ADD GENERATED ALWAYS AS IDENTITY;'), [
+    'makes a column GENERATED ALWAYS',
+  ]);
+  assert.deepEqual(why('ALTER TABLE t ALTER COLUMN id ADD GENERATED BY DEFAULT AS IDENTITY;'), []);
+});
+
+test('#899-2: scanning resumes after a quoted body', () => {
+  assert.deepEqual(why("DO 'BEGIN NULL; END'; ALTER TABLE t DROP COLUMN c;"), ['drops a column']);
+  assert.deepEqual(why("DO 'BEGIN NULL; END'; -- note\nALTER TABLE t DROP COLUMN c;"), ['drops a column']);
+  assert.deepEqual(
+    why("DO 'BEGIN NULL; END'; DO 'BEGIN ALTER TABLE t DROP COLUMN c; END'; ALTER TABLE t DROP COLUMN d;"),
+    ['drops a column', 'drops a column']
+  );
+  // A body containing the synthetic delimiter must not end the scan early.
+  assert.deepEqual(
+    why("DO 'BEGIN RAISE NOTICE ''$__body$''; END'; ALTER TABLE t DROP COLUMN c;"),
+    ['drops a column']
+  );
+});
+
+test('#899-2: single-quoted DO and AS bodies are code', () => {
+  assert.deepEqual(why("DO 'BEGIN ALTER TABLE t DROP COLUMN c; END';"), ['drops a column']);
+  assert.deepEqual(
+    why("CREATE FUNCTION f() RETURNS void AS 'BEGIN ALTER TABLE t DROP COLUMN c; END' LANGUAGE plpgsql;"),
+    ['drops a column']
+  );
+  assert.deepEqual(why("SELECT 'DROP TABLE z' AS note;"), []);
+});
+
+test('#899-3: DEFAULT (NULL) is no default', () => {
+  const noDefault = ['adds a NOT NULL column with no DEFAULT'];
+  assert.deepEqual(why('ALTER TABLE t ADD COLUMN c text NOT NULL DEFAULT (NULL);'), noDefault);
+  assert.deepEqual(why('ALTER TABLE t ADD COLUMN c text NOT NULL DEFAULT (NULL::text);'), noDefault);
+  assert.deepEqual(why('ALTER TABLE t ADD COLUMN c text NOT NULL DEFAULT (NULL)::text;'), noDefault);
+});
+
+test('#899-4: DROP DOMAIN and DROP EXTENSION with CASCADE are refused', () => {
+  assert.deepEqual(why('DROP DOMAIN d CASCADE;'), ['drops a domain with CASCADE']);
+  assert.deepEqual(why('DROP EXTENSION postgis CASCADE;'), ['drops an extension with CASCADE']);
+});
+
+test('#899-5: a statement starts at its code, not its leading comments', () => {
+  const [s] = statements('-- header\n\n-- note\nDROP TABLE x;');
+  assert.equal(s.line, 4);
+  assert.match(s.comments, /note/);
+});
